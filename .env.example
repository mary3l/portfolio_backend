# Supabase project settings — find these in your Supabase dashboard:
# Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the service_role key here (server-side only, never expose it to the browser)
SUPABASE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional: only this Supabase account is allowed to manage projects.
# Leave empty to allow any signed-in Supabase user of your project.
ADMIN_EMAIL=marmabs692@gmail.com
