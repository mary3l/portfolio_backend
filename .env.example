# Copy to .env and fill in. Never commit .env.
# Supabase dashboard -> Project Settings -> API

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Must be the service_role key (server-side only, never expose it to the browser).
# The anon key can only read; writes fail under row level security.
SUPABASE_KEY=YOUR-SERVICE-ROLE-KEY

# Required. Only this Supabase account may create/update/delete projects.
# The API refuses to start without it, so writes can never be left wide open.
ADMIN_EMAIL=you@example.com

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000

# Verbose logging and FastAPI debug mode. Leave false in production.
DEBUG=false

# --- Contact form (Resend) ---
# Sign up at resend.com -> API Keys -> Create. Leave empty to disable the
# contact endpoint; it then returns 503 instead of silently dropping messages.
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to ADMIN_EMAIL when empty.
CONTACT_TO_EMAIL=

# Must be a verified sender. Resend's shared test domain works immediately;
# swap in your own domain once you have verified it with them.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
